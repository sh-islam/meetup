# copy to .env and fill in
DB_PATH=/path/to/meetup/backend/meetup.db
FRONTEND_URL=https://sh-islam.github.io/meetup/
API_PUBLIC_URL=https://your-host.example/meetup-api
API_BASE_PATH=/meetup-api
CORS_ORIGINS=https://sh-islam.github.io,https://your-host.example
BIND=127.0.0.1:5090

# Gmail SMTP (dedicated account, app password, not the personal one)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Meetup
MAIL_FROM=
